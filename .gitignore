# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/outputs/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Android build state and signing material
/android/build/
/android/.kotlin/
*.hprof
*.jks
*.keystore
*.p12
*.pfx
*.pem
.env
.env.*
!.env.example

# Downloaded skill engines; keep the pinned skill sources and launchers
/.agents/skills/*/scripts/bin/

# Keep review reports, but not generated screenshots, logs or harness outputs
/.impeccable/review/*
!/.impeccable/review/*.md
